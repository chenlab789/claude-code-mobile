# Copy to .env and edit. .env is gitignored — never commit it.

# PIN the phone must enter (4-6 digits). The server only listens on 127.0.0.1;
# Tailscale is what makes it reachable, and only from your own devices.
PIN=000000
PORT=8780

# Folder Claude starts in (default: your home folder)
# WORKDIR=C:\Users\you

# Reply language for Claude, and the voices
REPLY_LANG=English
# edge-tts voice: run `edge-tts --list-voices`. Thai: th-TH-NiwatNeural / th-TH-PremwadeeNeural
VOICE=en-US-AndrewNeural
RATE=+10%
# on-device speech recognition language (BCP-47), e.g. th-TH
SPEECH_LANG=en-US

# Optional: server-side speech-to-text (ElevenLabs Scribe), for phones whose
# built-in recognition is blocked or weak. Toggle it in the app header.
# ELEVENLABS_API_KEY=
# ElevenLabs language code (e.g. tha, eng). Empty = auto-detect
# STT_LANG=

# Optional: full paths, if `claude` / `edge-tts` aren't on PATH
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
# EDGE_TTS=C:\Users\you\AppData\Local\Programs\Python\Python312\Scripts\edge-tts.exe
